# ${PROJECT_ID} — Component Fast Path defaults.
# Render-time substitution: ${PROJECT_ID} / ${COMPONENT_TYPE}.
# Runtime env interpolation: BACKEND_PORT / FRONTEND_PORT / etc. (resolved
# by docker compose and the Next.js / .NET hosts; no CAP token here).

# ── Frontend (Next.js 14) ────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ── Backend (.NET 8) ─────────────────────────────────────────────────
BACKEND_PORT=8080
FEEDBACK_ADMIN_BEARER=change-me

# ── Storage ─────────────────────────────────────────────────────────
# Default is in-memory; flip FEEDBACK_USE_POSTGRES=true to enable the
# PostgreSQL integration runtime (compose service `postgres`).
FEEDBACK_USE_POSTGRES=false
POSTGRES_DB=feedback
POSTGRES_USER=feedback
POSTGRES_PASSWORD=change-me
