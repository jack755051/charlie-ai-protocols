{
  "schema_version": 1,
  "project_id": "${PROJECT_ID}",
  "component_type": "${COMPONENT_TYPE}",
  "screens": [
    {
      "id": "feedback-submit",
      "route": "/feedback",
      "purpose": "User submits a rating + comment.",
      "sections": ["RatingControl", "FeedbackForm"],
      "states": ["idle", "submitting", "success", "validation_error", "server_error"],
      "primary_cta": "Submit feedback",
      "data_sources": ["FeedbackApiClient.submit"]
    },
    {
      "id": "feedback-admin-list",
      "route": "/admin/feedback",
      "purpose": "Admin reviews submitted feedback (bearer-token gated).",
      "sections": ["FeedbackListTable"],
      "states": ["loading", "empty", "loaded", "auth_error", "server_error"],
      "primary_cta": "Refresh list",
      "data_sources": ["FeedbackApiClient.list"]
    }
  ]
}
